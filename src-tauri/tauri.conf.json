{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tarang",
  "version": "0.1.1",
  "identifier": "dev.yashwanth.offlineplayer",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Tarang",
        "width": 1280,
        "height": 820,
        "minWidth": 360,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: https:; media-src 'self' asset: http://asset.localhost blob: http: https:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost http: https:",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**",
          "/**",
          "$HOME/**",
          "/storage/**",
          "/sdcard/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "shortDescription": "Offline-first music player",
    "category": "Music"
  },
  "mainBinaryName": "tarang",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkxNkU5RkJBODU0ODJBQjYKUldTMktraUZ1cDl1a1lNdks4d1lsOHpqbDArZGxMWS8zK0dQaGoxUDQzYzB6NEkxM2sxYU1PZkIK",
      "endpoints": [
        "https://github.com/Yashwanthkumaram/tarang/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
